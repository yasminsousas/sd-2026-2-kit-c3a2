# Usado so na demonstracao de resiliencia (README): a inferencia aponta para o LLM falso,
# com tempos curtos para o circuito abrir e fechar depressa.
#   docker compose --env-file .env.demo --profile demo up --build -d
LLM_API_KEY=demo
LLM_API_URL=http://llm-falso:9000/v1/chat/completions
LLM_TIMEOUT=3
LLM_BACKOFF=0.2
LLM_ESPERA_CIRCUITO=6
LLM_TENTATIVAS=3
LLM_LIMITE_FALHAS=3
RATE_LIMIT_RPM=600
GATEWAY_ESPERA_CIRCUITO=6
WORKER_ESPERA_CIRCUITO=6
