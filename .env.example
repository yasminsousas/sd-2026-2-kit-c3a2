# Copie para .env (cp .env.example .env) SO se quiser mudar algum padrao.
# Sem .env, `docker compose up --build` ja sobe tudo com valores de desenvolvimento.
# NUNCA commite o .env (ele esta no .gitignore).

# --- Gateway / seguranca ---
JWT_SEGREDO=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
JWT_EXPIRACAO_MIN=60
USUARIO_PADRAO=admin
SENHA_PADRAO=admin123
RATE_LIMIT_RPM=30
# AMBIENTE=producao   # em producao o gateway recusa subir com JWT_SEGREDO fraco

# --- Resultados assincronos (LGPD: tempo de retencao) ---
TTL_RESULTADOS_SEG=3600

# --- LLM (deixe LLM_API_KEY vazia para o MODO SIMULADO, offline) ---
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODELO=gpt-4o-mini
# LLM_TIMEOUT=10
# LLM_TENTATIVAS=3
# LLM_BACKOFF=0.5
# LLM_LIMITE_FALHAS=3
# LLM_ESPERA_CIRCUITO=20

# --- Rede ---
# BIND_ADDR=0.0.0.0   # publica gateway e Jaeger na rede (padrao: so 127.0.0.1)
# GATEWAY_PORTA=8000  # porta do gateway no host (troque se a 8000 estiver ocupada)
